b2b73450fa22202aefe9252d6e35c333e0e66d5240d47a67771987b768add03969494d5f7b9185661c40bba09487c5472a9615b57c7e1baa4611d760e32323d3  0001-backend-drm-treat-a-gamma-reset-as-a-no-op-on-CRTCs-.patch
"
