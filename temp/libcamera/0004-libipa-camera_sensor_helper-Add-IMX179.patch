From f6d658075860f90abc66458f13e086a8d1dd28e6 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sun, 1 Nov 2026 20:05:16 -0500
Subject: [PATCH] libipa: camera_sensor_helper: Add IMX179

The Sony IMX179 uses the SMIA analogue gain model, gain = 256 / (256 -
code), with a 10-bit black level of 64. Add its sensor helper and its
properties: 1.4 um pixels and the test patterns of the mainline driver.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp          | 12 ++++++++++++
 .../sensor/camera_sensor_properties.cpp          | 16 ++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index e3e3e53..96df0b8 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -542,6 +542,18 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx214", CameraSensorHelperImx214)
 
+class CameraSensorHelperImx179 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx179()
+	{
+		/* 64 at 10 bits, as on other Sony SMIA sensors. */
+		blackLevel_ = 4096;
+		gain_ = AnalogueGainLinear{ 0, 256, -1, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx179", CameraSensorHelperImx179)
+
 class CameraSensorHelperImx219 : public CameraSensorHelper
 {
 public:
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index b217363..bb32270 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -194,6 +194,22 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 			},
 			.sensorDelays = { },
 		} },
+		{ "imx179", {
+			.unitCellSize = { 1400, 1400 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeSolidColor, 1 },
+				{ controls::draft::TestPatternModeColorBars, 2 },
+				{ controls::draft::TestPatternModeColorBarsFadeToGray, 3 },
+				{ controls::draft::TestPatternModePn9, 4 },
+			},
+			.sensorDelays = {
+				.exposureDelay = 2,
+				.gainDelay = 1,
+				.vblankDelay = 2,
+				.hblankDelay = 2
+			},
+		} },
 		{ "imx219", {
 			.unitCellSize = { 1120, 1120 },
 			.testPatternModes = {
-- 
2.56.0

