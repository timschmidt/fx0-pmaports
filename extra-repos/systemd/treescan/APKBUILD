# Forked from Alpine for the 32-bit time_t formatting correction
maintainer="Ariadne Conill <ariadne@ariadne.space>"
pkgname=treescan
pkgver=0.1
pkgrel=1
pkgdesc="directory tree scanning tool"
url="https://github.com/kaniini/treescan"
arch="all"
license="0BSD"
checkdepends="python3"
source="https://github.com/kaniini/treescan/archive/v$pkgver/treescan-$pkgver.tar.gz
	0001-fix-time64-format.patch
	check-timestamps.py
	"
options="!pmb:crossdirect"

build() {
	make CFLAGS="$CFLAGS -Wformat=2 -Werror=format"
}

check() {
	python3 "$srcdir/check-timestamps.py" ./treescan
}

package() {
	make DESTDIR="$pkgdir" install
}

