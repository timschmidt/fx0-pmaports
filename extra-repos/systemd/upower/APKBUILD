# Forked from Alpine for systemd support
maintainer="Achill Gilgenast <achill@achill.org>"
pkgname=upower
_pkgver=1.91.0
pkgver=9999$_pkgver
pkgrel=4
pkgdesc="Power Management Services"
url="https://upower.freedesktop.org"
# armhf: pmb#2618
arch="all !armhf"
license="GPL-2.0-or-later"
makedepends="
	docbook-xsl
	glib-dev
	gobject-introspection-dev
	gtk-doc
	libgudev-dev
	libxslt
	meson
	udev-dev
	polkit-dev
	"
checkdepends="
	dbus
	py3-dbus
	py3-dbusmock
	py3-gobject3
	py3-packaging
	umockdev-dev
	"
_repo_url="https://gitlab.freedesktop.org/upower/upower.git"
subpackages="$pkgname-dev $pkgname-doc $pkgname-lang $pkgname-systemd $pkgname-zsh-completion"
source="https://gitlab.freedesktop.org/upower/upower/-/archive/v$_pkgver/upower-v$_pkgver.tar.bz2
	0001-fix-self-test-sleep-duration.patch
	0002-tests-cover-CLI-device-enumeration-errors.patch
	0003-up-tool-Free-GPtrArray-using-Glib-auto-clean-up.patch
	0004-tools-up-tool-Fix-a-leak-by-freeing-GMainLoop-using-GLib-auto-clean-up.patch
	0005-tools-up-tool-Free-the-memory-with-GLib-auto-clean-up.patch
	0006-up-tool-Fix-potential-segmentation-fault.patch
	0007-linux-reject-battery-interfaces-without-charge-information.patch
	"
builddir="$srcdir/$pkgname-v$_pkgver"

options="$options !check !pmb:crossdirect" # failure on systemd, ignoring

case "$CARCH" in
x86)
	# one test with 40.0 != 40.00000000
	options="$options !check"
	;;
esac

build() {
	abuild-meson \
		-Dudevhwdbdir=/usr/lib/udev/hwdb.d/ \
		-Dudevrulesdir=/usr/lib/udev/rules.d \
		-Dsystemdsystemunitdir=/usr/lib/systemd/system \
		-Dman=true \
		. output
	meson compile -C output
}

check() {
	meson test -t 5 --print-errorlogs -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
	# Delete integration tests and its support files.
	rm -rf "$pkgdir/usr/libexec/upower/" \
		"$pkgdir/usr/share/installed-tests/upower/upower-integration.test"
}

