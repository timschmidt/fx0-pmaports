# Reference: <https://postmarketos.org/devicepkg>
# Maintainer: Timothy Schmidt <timschmidt@gmail.com>
pkgname=device-lg-madai
pkgdesc="LG Fx0"
pkgver=1
pkgrel=1
url="https://github.com/timschmidt/fx0"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	boot-deploy>=0.23.0-r1
	firmware-qcom-adreno-a330
	linux-postmarketos-qcom-msm8226
	mkbootimg-osm0sis
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm8226
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	ucm-card.conf
	ucm-HiFi.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# The card's long name selects the UCM profile, so the file name has a space
	install -Dm644 "$srcdir"/ucm-card.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/apq8096/LG Fx0.conf"
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Qualcomm/msm8926/lg-fx0/HiFi.conf
}

