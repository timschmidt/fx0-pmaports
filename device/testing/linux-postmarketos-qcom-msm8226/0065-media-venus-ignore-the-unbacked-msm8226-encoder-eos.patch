From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 20:47:06 -0500
Subject: [PATCH 5/5] media: venus: Ignore the unbacked MSM8226 encoder EOS
 acknowledgement

---
 drivers/media/platform/qcom/venus/hfi_helper.h |  2 ++
 drivers/media/platform/qcom/venus/hfi_msgs.c   | 13 +++++++++++++
 drivers/media/platform/qcom/venus/venc.c       |  6 ++----
 3 files changed, 17 insertions(+), 4 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/hfi_helper.h b/drivers/media/platform/qcom/venus/hfi_helper.h
index f44059f19..a03eecd49 100644
--- a/drivers/media/platform/qcom/venus/hfi_helper.h
+++ b/drivers/media/platform/qcom/venus/hfi_helper.h
@@ -81,6 +81,8 @@
 #define HFI_BUFFERFLAG_TEI				0x40000000
 #define HFI_BUFFERFLAG_DISCONTINUITY			0x80000000
 
+#define HFI_ENCODER_EOS_INPUT_TAG			U32_MAX
+
 #define HFI_ERR_SESSION_EMPTY_BUFFER_DONE_OUTPUT_PENDING	0x1001001
 #define HFI_ERR_SESSION_SAME_STATE_OPERATION			0x1001002
 #define HFI_ERR_SESSION_SYNC_FRAME_NOT_DETECTED			0x1001003
diff --git a/drivers/media/platform/qcom/venus/hfi_msgs.c b/drivers/media/platform/qcom/venus/hfi_msgs.c
index 66855dad5..158f52226 100644
--- a/drivers/media/platform/qcom/venus/hfi_msgs.c
+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c
@@ -5,6 +5,7 @@
  */
 #include <linux/hash.h>
 #include <linux/list.h>
+#include <linux/of.h>
 #include <linux/slab.h>
 #include <linux/soc/qcom/smem.h>
 #include <media/videobuf2-v4l2.h>
@@ -545,6 +546,16 @@ static void hfi_session_etb_done(struct venus_core *core,
 			    pkt->filled_len, pkt->offset, 0, 0, 0);
 }
 
+static bool hfi_enc_unbacked_eos_ack(struct venus_core *core,
+				     const struct hfi_msg_session_fbd_compressed_pkt *pkt)
+{
+	/* This reply acknowledges the synthetic input without returning a capture buffer. */
+	return IS_V1(core) && pkt->input_tag == HFI_ENCODER_EOS_INPUT_TAG &&
+	       !pkt->output_tag && !pkt->packet_buffer && !pkt->error_type &&
+	       !pkt->flags && !pkt->filled_len && !pkt->offset &&
+	       of_device_is_compatible(core->dev->of_node, "qcom,msm8226-venus");
+}
+
 static void hfi_session_ftb_done(struct venus_core *core,
 				 struct venus_inst *inst, void *packet)
 {
@@ -573,6 +584,8 @@ static void hfi_session_ftb_done(struct venus_core *core,
 				"encoder HFI capture done: tag %#x input %#x status %#x flags %#x size %u offset %u IOVA %#x\n",
 				output_tag, pkt->input_tag, error, hfi_flags, filled_len,
 				offset, pkt->packet_buffer);
+		if (hfi_enc_unbacked_eos_ack(core, pkt))
+			return;
 	} else if (session_type == VIDC_SESSION_TYPE_DEC) {
 		struct hfi_msg_session_fbd_uncompressed_plane0_pkt *pkt =
 			packet;
diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index e8e007974..584550b00 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -25,8 +25,6 @@
 #include "pm_helpers.h"
 
 #define NUM_B_FRAMES_MAX	4
-#define VENC_EOS_INPUT_TAG	U32_MAX
-
 struct venc_inst {
 	struct venus_inst base;
 	void *eos_buffer;
@@ -590,7 +588,7 @@ venc_encoder_cmd(struct file *file, void *fh, struct v4l2_encoder_cmd *cmd)
 		if (ret)
 			goto unlock;
 		/* Input buffer completions otherwise identify VB2 buffer indices. */
-		fdata.clnt_data = VENC_EOS_INPUT_TAG;
+		fdata.clnt_data = HFI_ENCODER_EOS_INPUT_TAG;
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1401,7 +1399,7 @@ static void venc_buf_done(struct venus_inst *inst, unsigned int buf_type,
 
 	venc_pm_touch(inst);
 
-	if (buf_type == HFI_BUFFER_INPUT && tag == VENC_EOS_INPUT_TAG)
+	if (buf_type == HFI_BUFFER_INPUT && tag == HFI_ENCODER_EOS_INPUT_TAG)
 		return;
 
 	if (buf_type == HFI_BUFFER_INPUT)
