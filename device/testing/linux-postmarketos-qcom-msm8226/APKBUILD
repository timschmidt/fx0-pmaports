876dac2b3413400f32defb36955d00a24b0ef69a37c72ad6915043820b9cf6256d0cef8345bed1c8935653bedcd5d309e4a7628910fdcdb3cc45d6fe3b852f3b  config-postmarketos-qcom-msm8226.armv7
"
