57f26e48a30c5988459362c76c3ff052222854e4c9dfe8bb05745f5370c36bf43e19b1a273a26cbc67ff30467c57850c081c7dcb63a6d2d0224c43b749dc2949  config-postmarketos-qcom-msm8226.armv7
"
