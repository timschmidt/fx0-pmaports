d494f4460ea4043dc2b46e8f43c5b6e063a709e6c9f3d86de099179803407e6bcb25c290c6596083315b3fe5651230e41bf2adafab1c768039edd5bdac3e1fc9  config-postmarketos-qcom-msm8226.armv7
"
