336cc8d2630e6d5defd544d69ecd4b2dd1e440dab01a03ebad8fe87cb8eaf9df68a61e2a07c66a8aed1a1b8c7c7a6ba4c3bd8c0189a37eb84163fea908a2afe9  config-postmarketos-qcom-msm8226.armv7
"
