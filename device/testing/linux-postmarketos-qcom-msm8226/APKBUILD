maintainer="Newbyte <newbie13xd@gmail.com>"
_flavor="postmarketos-qcom-msm8226"
pkgname=linux-$_flavor
pkgver=6.18.64
pkgrel=4
pkgdesc="Mainline Kernel fork for APQ8026/MSM8226/MSM8926 devices"
arch="armv7"
_carch="arm"
url="https://github.com/timschmidt/fx0-linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-community
	"
makedepends="
	bison
	clang
	findutils
	flex
	kmod
	lld
	llvm
	openssl-dev
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"

_config="config-$_flavor.$arch"
# Fx0 development integration; shared-SoC regression qualification is pending.
_commit="c3e72d14babc2e875b89cadde5ed57bb54b11a0b"

# Source
source="
	linux-fx0-$_commit.tar.gz::https://github.com/timschmidt/fx0-linux/archive/$_commit.tar.gz
	$_config
	0001-fx0-smbb-battery-voltage.patch
	0002-camss-msm8226-guard-active-stream-sleep.patch
	0003-camss-gen1-ignore-wm-completion-while-stopping.patch
	0004-camss-msm8226-rearm-rdi-at-sof.patch
	0005-camss-clear-vfe-buffer-slots-when-flushing.patch
	0006-camss-unwind-partially-started-pipeline.patch
	0007-camss-msm8226-preserve-rdi-capture-across-sleep.patch
	0008-camss-msm8226-count-csid-vfe-references.patch
"
builddir="$srcdir/fx0-linux-$_commit"

_kernel_make() {
	local timestamp
	: "${FX0_KERNEL_MODULE_SIGNING_KEY:?provide the existing trusted signer explicitly; automatic key generation is prohibited}"
	case "$FX0_KERNEL_MODULE_SIGNING_KEY" in
		/*) ;;
		*) printf '%s\n' "FX0_KERNEL_MODULE_SIGNING_KEY must name an existing absolute path" >&2; return 1 ;;
	esac
	if [ ! -f "$FX0_KERNEL_MODULE_SIGNING_KEY" ] || [ ! -r "$FX0_KERNEL_MODULE_SIGNING_KEY" ]; then
		printf '%s\n' "The explicit signer path must already exist and be readable" >&2
		return 1
	fi
	: "${SOURCE_DATE_EPOCH:?abuild must provide SOURCE_DATE_EPOCH}"
	timestamp="$(date -u -d "@$SOURCE_DATE_EPOCH" '+%Y-%m-%d %H:%M:%S')" || return 1
	TZ=UTC KBUILD_BUILD_USER=pmos KBUILD_BUILD_HOST=postmarketos \
		KBUILD_BUILD_TIMESTAMP="$timestamp" \
		make ARCH="$_carch" LLVM=1 LOCALVERSION="" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor" \
		CONFIG_MODULE_SIG_KEY="$FX0_KERNEL_MODULE_SIGNING_KEY" \
		"$@"
}

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
	_kernel_make olddefconfig
}

build() {
	unset LDFLAGS
	_kernel_make
}

package() {
	mkdir -p "$pkgdir"/boot
	_kernel_make zinstall modules_install dtbs_install \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/lib/modules/*/build "$pkgdir"/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

