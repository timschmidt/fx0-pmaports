834601ae7b5b8f542957c79af8ef776c80bb817b972f003b5db3f63b6c06372179ad35aa19e919a6d59c2ac6b40e0f2469eadcc5a23de70971d46d49c35a71a2  config-postmarketos-qcom-msm8226.armv7
"
