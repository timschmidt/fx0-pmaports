570d79c0a416b142aed78f91658a84a65926d00054869a4155986ffa66f2d7772c95c1f2c8f436f31498480d8e9ec45a0535d8c8976f2bcbe95cfe4c9297bfb2  config-postmarketos-qcom-msm8226.armv7
"
