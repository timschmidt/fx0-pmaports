 .../media/platform/qcom/camss/camss-video.c   | 172 +++++++++++++++---
 .../media/platform/qcom/camss/camss-video.h   |   5 +
 drivers/media/platform/qcom/camss/camss.c     |  67 +++++--
 drivers/media/platform/qcom/camss/camss.h     |   3 +
 5 files changed, 213 insertions(+), 37 deletions(-)

