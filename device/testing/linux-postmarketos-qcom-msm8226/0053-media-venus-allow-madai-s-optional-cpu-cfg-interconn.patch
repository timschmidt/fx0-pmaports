From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 01:12:43 -0500
Subject: [PATCH 15/22] media: venus: allow Madai's optional cpu-cfg
 interconnect

The MSM8226 binding permits video-mem as the sole interconnect. A named cpu-cfg lookup returns -ENODATA when the list only contains video-mem, stopping probe before firmware boot. Skip the optional lookup on MSM8226 when the name is absent and retain errors for a supplied path.
---
 drivers/media/platform/qcom/venus/core.c | 12 +++++++++---
 drivers/media/platform/qcom/venus/core.h |  1 +
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.c b/drivers/media/platform/qcom/venus/core.c
index 70a7a5aa7..847ae101c 100644
--- a/drivers/media/platform/qcom/venus/core.c
+++ b/drivers/media/platform/qcom/venus/core.c
@@ -500,9 +500,14 @@ static int venus_probe(struct platform_device *pdev)
 	if (core->res->require_video_path && !core->video_path)
 		return dev_err_probe(dev, -ENODEV, "video-mem interconnect required\n");
 
-	core->cpucfg_path = devm_of_icc_get(dev, "cpu-cfg");
-	if (IS_ERR(core->cpucfg_path))
-		return PTR_ERR(core->cpucfg_path);
+	if (!core->res->optional_cpu_cfg_path ||
+	    of_property_match_string(dev->of_node, "interconnect-names",
+				     "cpu-cfg") != -ENODATA) {
+		core->cpucfg_path = devm_of_icc_get(dev, "cpu-cfg");
+		if (IS_ERR(core->cpucfg_path))
+			return dev_err_probe(dev, PTR_ERR(core->cpucfg_path),
+					     "failed to get cpu-cfg interconnect\n");
+	}
 
 	core->irq = platform_get_irq(pdev, 0);
 	if (core->irq < 0)
@@ -820,6 +825,7 @@ static const struct venus_resources msm8226_res = {
 	.enc_nodename = "video-encoder",
 	.split_reg_banks = true,
 	.require_video_path = true,
+	.optional_cpu_cfg_path = true,
 	.bw_per_direction = true,
 };
 
diff --git a/drivers/media/platform/qcom/venus/core.h b/drivers/media/platform/qcom/venus/core.h
index ec1da1d8a..abdf76285 100644
--- a/drivers/media/platform/qcom/venus/core.h
+++ b/drivers/media/platform/qcom/venus/core.h
@@ -108,6 +108,7 @@ struct venus_resources {
 	const struct firmware_version *min_fw;
 	bool split_reg_banks;
 	bool require_video_path;
+	bool optional_cpu_cfg_path;
 	bool bw_per_direction;
 };
 
