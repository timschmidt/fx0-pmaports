From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 13:45:40 -0500
Subject: [PATCH 20/22] interconnect: qcom: Keep the Madai MMSS interface clock
 referenced

Releasing the temporary QoS probe reference on Madai can stall the
active display and USB. Take a managed reference while the MMSS
provider is bound. Defer until the RPM proxy is ready before taking
the clock reference.
---
 drivers/interconnect/qcom/msm8226.c | 26 +++++++++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/drivers/interconnect/qcom/msm8226.c b/drivers/interconnect/qcom/msm8226.c
index 74e7bc0d7..4f3ce08e6 100644
--- a/drivers/interconnect/qcom/msm8226.c
+++ b/drivers/interconnect/qcom/msm8226.c
@@ -4,6 +4,7 @@
  * Copyright (c) 2013-2014, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -157,8 +158,31 @@ static const struct of_device_id msm8226_icc_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, msm8226_icc_of_match);
 
+static int msm8226_icc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk *iface;
+
+	if (of_machine_is_compatible("lg,madai") &&
+	    of_device_is_compatible(dev->of_node, "qcom,msm8226-mmssnoc")) {
+		if (!qcom_icc_rpm_smd_available())
+			return -EPROBE_DEFER;
+
+		/*
+		 * The live display path relies on the shared MMSS interface
+		 * clock before it has an explicit Linux interconnect vote.
+		 */
+		iface = devm_clk_get_enabled(dev, "iface");
+		if (IS_ERR(iface))
+			return dev_err_probe(dev, PTR_ERR(iface),
+					     "cannot keep MMSS interface clock on\n");
+	}
+
+	return qnoc_probe(pdev);
+}
+
 static struct platform_driver msm8226_icc_driver = {
-	.probe = qnoc_probe,
+	.probe = msm8226_icc_probe,
 	.remove = qnoc_remove,
 	.driver = {
 		.name = "qnoc-msm8226",
