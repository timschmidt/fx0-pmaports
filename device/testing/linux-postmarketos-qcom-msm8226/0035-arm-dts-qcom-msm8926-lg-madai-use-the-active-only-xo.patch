From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 21 Nov 2026 04:16:46 -0500
Subject: [PATCH 15/16] ARM: dts: qcom: msm8926-lg-madai: use the active-only
 XO for MMCC and USB PHY

The multimedia clock controller and the USB HS PHY only need the crystal
while the application processor runs. Voting the RPM XO from them kept
XO on in the RPM sleep set; with the active-only XO the RPM reaches XO
shutdown in system sleep.

Assisted-by: LLM [Claude Code]
---
 .../boot/dts/qcom/qcom-msm8926-lg-madai.dts   | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
index 6d538045c..70c5f4eb9 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
@@ -833,3 +833,23 @@ cpr_redundant: cpr-redundant@458 {
 		};
 	};
 };
+
+/*
+ * FX0 DIAGNOSTIC: the multimedia clock controller and the USB HS PHY only
+ * need the crystal while the application processor runs. Use the active-only
+ * RPM XO so their votes do not keep XO on in the RPM sleep set.
+ */
+&mmcc {
+	clocks = <&rpmcc RPM_SMD_XO_A_CLK_SRC>,
+		 <&gcc GCC_MMSS_GPLL0_CLK_SRC>,
+		 <&gcc GPLL0_VOTE>,
+		 <&gcc GPLL1_VOTE>,
+		 <&rpmcc RPM_SMD_GFX3D_CLK_SRC>,
+		 <&mdss_dsi0_phy DSI_PIXEL_PLL_CLK>,
+		 <&mdss_dsi0_phy DSI_BYTE_PLL_CLK>;
+};
+
+&usb_hs_phy {
+	clocks = <&rpmcc RPM_SMD_XO_A_CLK_SRC>,
+		 <&gcc GCC_USB2A_PHY_SLEEP_CLK>;
+};
