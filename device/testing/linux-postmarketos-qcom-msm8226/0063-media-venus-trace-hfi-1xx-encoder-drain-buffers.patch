From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 20:19:05 -0500
Subject: [PATCH 3/5] media: venus: Trace HFI 1xx encoder drain buffers

---
 drivers/media/platform/qcom/venus/hfi_msgs.c  |  7 +++++++
 drivers/media/platform/qcom/venus/hfi_venus.c | 17 ++++++++++++++++-
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/qcom/venus/hfi_msgs.c b/drivers/media/platform/qcom/venus/hfi_msgs.c
index 47b99d5b5..6f19c280d 100644
--- a/drivers/media/platform/qcom/venus/hfi_msgs.c
+++ b/drivers/media/platform/qcom/venus/hfi_msgs.c
@@ -537,6 +537,9 @@ static void hfi_session_etb_done(struct venus_core *core,
 {
 	struct hfi_msg_session_empty_buffer_done_pkt *pkt = packet;
 
+	if (IS_V1(core) && inst->session_type == VIDC_SESSION_TYPE_ENC)
+		dev_dbg(core->dev, "encoder HFI input done: tag %#x status %#x size %u offset %u\n",
+			pkt->input_tag, pkt->error_type, pkt->filled_len, pkt->offset);
 	inst->error = pkt->error_type;
 	inst->ops->buf_done(inst, HFI_BUFFER_INPUT, pkt->input_tag,
 			    pkt->filled_len, pkt->offset, 0, 0, 0);
@@ -565,6 +568,10 @@ static void hfi_session_ftb_done(struct venus_core *core,
 		buffer_type = HFI_BUFFER_OUTPUT;
 
 		error = pkt->error_type;
+		if (IS_V1(core))
+			dev_dbg(core->dev,
+				"encoder HFI capture done: tag %#x input %#x status %#x flags %#x size %u offset %u\n",
+				output_tag, pkt->input_tag, error, hfi_flags, filled_len, offset);
 	} else if (session_type == VIDC_SESSION_TYPE_DEC) {
 		struct hfi_msg_session_fbd_uncompressed_plane0_pkt *pkt =
 			packet;
diff --git a/drivers/media/platform/qcom/venus/hfi_venus.c b/drivers/media/platform/qcom/venus/hfi_venus.c
index b3a5b7d26..c46dd5d61 100644
--- a/drivers/media/platform/qcom/venus/hfi_venus.c
+++ b/drivers/media/platform/qcom/venus/hfi_venus.c
@@ -1330,7 +1330,14 @@ static int venus_session_etb(struct venus_inst *inst,
 		if (ret)
 			return ret;
 
+		if (IS_V1(inst->core))
+			dev_dbg(inst->core->dev,
+				"encoder HFI queue input: tag %#x size %u allocation %u flags %#x\n",
+				pkt.input_tag, pkt.filled_len, pkt.alloc_len, pkt.flags);
 		ret = venus_iface_cmdq_write(hdev, &pkt, false);
+		if (ret && IS_V1(inst->core))
+			dev_dbg(inst->core->dev, "encoder HFI input queue error: tag %#x errno %d\n",
+				pkt.input_tag, ret);
 	} else {
 		ret = -EINVAL;
 	}
@@ -1342,6 +1349,7 @@ static int venus_session_ftb(struct venus_inst *inst,
 			     struct hfi_frame_data *out_frame)
 {
 	struct venus_hfi_device *hdev = to_hfi_priv(inst->core);
+	bool trace = IS_V1(inst->core) && inst->session_type == VIDC_SESSION_TYPE_ENC;
 	struct hfi_session_fill_buffer_pkt pkt;
 	int ret;
 
@@ -1349,7 +1357,14 @@ static int venus_session_ftb(struct venus_inst *inst,
 	if (ret)
 		return ret;
 
-	return venus_iface_cmdq_write(hdev, &pkt, false);
+	if (trace)
+		dev_dbg(inst->core->dev, "encoder HFI queue capture: tag %#x allocation %u\n",
+			pkt.output_tag, pkt.alloc_len);
+	ret = venus_iface_cmdq_write(hdev, &pkt, false);
+	if (ret && trace)
+		dev_dbg(inst->core->dev, "encoder HFI capture queue error: tag %#x errno %d\n",
+			pkt.output_tag, ret);
+	return ret;
 }
 
 static int venus_session_set_buffers(struct venus_inst *inst,
