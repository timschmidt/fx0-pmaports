From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Tue, 17 Nov 2026 23:31:47 -0500
Subject: [PATCH 08/22] interconnect: qcom: Add the MSM8226 Venus-to-memory
 preview

Translate the CAF Video P0, MMSS-to-BIMC gateway and DDR channel route into the SMD RPM backend. The application processor owns both QoS ports. The stock route votes for EBI slave 0 through the RPM.

Link: https://github.com/peremen/android-kernel-lg-madai/blob/03aba4427a7666d57b5ae06d375e259ea337f351/arch/arm/boot/dts/msm8226-bus.dtsi
Signed-off-by: Timothy Schmidt <timschmidt@gmail.com>
---
 drivers/interconnect/qcom/Kconfig   |  11 +++
 drivers/interconnect/qcom/Makefile  |   2 +
 drivers/interconnect/qcom/msm8226.c | 144 ++++++++++++++++++++++++++++
 3 files changed, 157 insertions(+)
 create mode 100644 drivers/interconnect/qcom/msm8226.c

diff --git a/drivers/interconnect/qcom/Kconfig b/drivers/interconnect/qcom/Kconfig
index 5b4bb9f13..d99f96518 100644
--- a/drivers/interconnect/qcom/Kconfig
+++ b/drivers/interconnect/qcom/Kconfig
@@ -17,6 +17,17 @@ config INTERCONNECT_QCOM_GLYMUR
          This is a driver for the Qualcomm Network-on-Chip on glymur-based
          platforms.
 
+config INTERCONNECT_QCOM_MSM8226
+	tristate "Qualcomm MSM8226 multimedia interconnect preview"
+	depends on INTERCONNECT_QCOM
+	depends on QCOM_SMD_RPM
+	select INTERCONNECT_QCOM_SMD_RPM
+	help
+	  Support the MSM8226 multimedia-to-memory route used by Venus.
+	  The multimedia NoC uses the multimedia clock controller and
+	  votes on the memory bus go through the Qualcomm RPM.
+	  This diagnostic option describes the Venus data path.
+
 config INTERCONNECT_QCOM_MSM8909
 	tristate "Qualcomm MSM8909 interconnect driver"
 	depends on INTERCONNECT_QCOM
diff --git a/drivers/interconnect/qcom/Makefile b/drivers/interconnect/qcom/Makefile
index cf8cba73e..72e4cde54 100644
--- a/drivers/interconnect/qcom/Makefile
+++ b/drivers/interconnect/qcom/Makefile
@@ -6,6 +6,7 @@ interconnect_qcom-y			:= icc-common.o
 icc-bcm-voter-objs			:= bcm-voter.o
 qnoc-glymur-objs			:= glymur.o
 qnoc-milos-objs				:= milos.o
+qnoc-msm8226-objs			:= msm8226.o
 qnoc-msm8909-objs			:= msm8909.o
 qnoc-msm8916-objs			:= msm8916.o
 qnoc-msm8937-objs			:= msm8937.o
@@ -49,6 +50,7 @@ icc-smd-rpm-objs			:= smd-rpm.o icc-rpm.o icc-rpm-clocks.o
 obj-$(CONFIG_INTERCONNECT_QCOM_BCM_VOTER) += icc-bcm-voter.o
 obj-$(CONFIG_INTERCONNECT_QCOM_GLYMUR) += qnoc-glymur.o
 obj-$(CONFIG_INTERCONNECT_QCOM_MILOS) += qnoc-milos.o
+obj-$(CONFIG_INTERCONNECT_QCOM_MSM8226) += qnoc-msm8226.o
 obj-$(CONFIG_INTERCONNECT_QCOM_MSM8909) += qnoc-msm8909.o
 obj-$(CONFIG_INTERCONNECT_QCOM_MSM8916) += qnoc-msm8916.o
 obj-$(CONFIG_INTERCONNECT_QCOM_MSM8937) += qnoc-msm8937.o
diff --git a/drivers/interconnect/qcom/msm8226.c b/drivers/interconnect/qcom/msm8226.c
new file mode 100644
index 000000000..aa788b18b
--- /dev/null
+++ b/drivers/interconnect/qcom/msm8226.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MSM8226 multimedia-to-memory topology from the CAF MSM8226 bus tables.
+ * Copyright (c) 2013-2014, The Linux Foundation. All rights reserved.
+ */
+
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+
+#include <dt-bindings/interconnect/qcom,msm8226.h>
+
+#include "icc-rpm.h"
+
+enum {
+	MSM8226_MASTER_VIDEO_P0 = 8226,
+	MSM8226_SLAVE_MMSS_BIMC,
+	MSM8226_MASTER_BIMC_MMSS,
+	MSM8226_SLAVE_EBI_CH0,
+};
+
+static const u16 video_p0_links[] = { MSM8226_SLAVE_MMSS_BIMC };
+static const u16 mmss_bimc_links[] = { MSM8226_MASTER_BIMC_MMSS };
+static const u16 bimc_mmss_links[] = { MSM8226_SLAVE_EBI_CH0 };
+
+static struct qcom_icc_node mas_video_p0 = {
+	.name = "mas_video_p0",
+	.id = MSM8226_MASTER_VIDEO_P0,
+	.links = video_p0_links,
+	.num_links = ARRAY_SIZE(video_p0_links),
+	/* Use the width of the downstream MMSS-to-BIMC hop. */
+	.buswidth = 16,
+	.mas_rpm_id = -1,
+	.slv_rpm_id = -1,
+	.qos = {
+		.ap_owned = true,
+		.qos_mode = NOC_QOS_MODE_BYPASS,
+		.qos_port = 4,
+	},
+};
+
+static struct qcom_icc_node slv_mmss_bimc = {
+	.name = "slv_mmss_bimc",
+	.id = MSM8226_SLAVE_MMSS_BIMC,
+	.links = mmss_bimc_links,
+	.num_links = ARRAY_SIZE(mmss_bimc_links),
+	.buswidth = 16,
+	.mas_rpm_id = -1,
+	.slv_rpm_id = -1,
+	.qos.ap_owned = true,
+};
+
+static struct qcom_icc_node mas_bimc_mmss = {
+	.name = "mas_bimc_mmss",
+	.id = MSM8226_MASTER_BIMC_MMSS,
+	.links = bimc_mmss_links,
+	.num_links = ARRAY_SIZE(bimc_mmss_links),
+	.buswidth = 8,
+	.mas_rpm_id = -1,
+	.slv_rpm_id = -1,
+	.qos = {
+		.ap_owned = true,
+		.qos_mode = NOC_QOS_MODE_BYPASS,
+		.qos_port = 2,
+	},
+};
+
+static struct qcom_icc_node slv_ebi_ch0 = {
+	.name = "slv_ebi_ch0",
+	.id = MSM8226_SLAVE_EBI_CH0,
+	.buswidth = 8,
+	.mas_rpm_id = -1,
+	.slv_rpm_id = 0,
+};
+
+static struct qcom_icc_node * const msm8226_mmss_nodes[] = {
+	[MSM8226_MMSS_MASTER_VIDEO_P0] = &mas_video_p0,
+	[MSM8226_MMSS_SLAVE_BIMC] = &slv_mmss_bimc,
+};
+
+static const char * const msm8226_mmss_intf_clocks[] = { "iface" };
+
+static const struct regmap_config msm8226_mmss_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0x3ffc,
+	.fast_io = true,
+};
+
+static const struct qcom_icc_desc msm8226_mmss = {
+	.type = QCOM_ICC_NOC,
+	.nodes = msm8226_mmss_nodes,
+	.num_nodes = ARRAY_SIZE(msm8226_mmss_nodes),
+	.intf_clocks = msm8226_mmss_intf_clocks,
+	.num_intf_clocks = ARRAY_SIZE(msm8226_mmss_intf_clocks),
+	.regmap_cfg = &msm8226_mmss_regmap_config,
+	.qos_offset = 0x3000,
+	.noc_qos_stride = 0x80,
+};
+
+static struct qcom_icc_node * const msm8226_bimc_nodes[] = {
+	[MSM8226_BIMC_MASTER_MMSS] = &mas_bimc_mmss,
+	[MSM8226_BIMC_SLAVE_EBI_CH0] = &slv_ebi_ch0,
+};
+
+static const struct regmap_config msm8226_bimc_regmap_config = {
+	.reg_bits = 32,
+	.val_bits = 32,
+	.reg_stride = 4,
+	.max_register = 0x69ffc,
+	.fast_io = true,
+};
+
+static const struct qcom_icc_desc msm8226_bimc = {
+	.type = QCOM_ICC_BIMC,
+	.nodes = msm8226_bimc_nodes,
+	.num_nodes = ARRAY_SIZE(msm8226_bimc_nodes),
+	.bus_clk_desc = &bimc_clk,
+	.keep_alive = true,
+	.regmap_cfg = &msm8226_bimc_regmap_config,
+	.qos_offset = 0x8000,
+};
+
+static const struct of_device_id msm8226_icc_of_match[] = {
+	{ .compatible = "qcom,msm8226-bimc", .data = &msm8226_bimc },
+	{ .compatible = "qcom,msm8226-mmssnoc", .data = &msm8226_mmss },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, msm8226_icc_of_match);
+
+static struct platform_driver msm8226_icc_driver = {
+	.probe = qnoc_probe,
+	.remove = qnoc_remove,
+	.driver = {
+		.name = "qnoc-msm8226",
+		.of_match_table = msm8226_icc_of_match,
+	},
+};
+module_platform_driver(msm8226_icc_driver);
+
+MODULE_DESCRIPTION("Qualcomm MSM8226 multimedia interconnect preview");
+MODULE_LICENSE("GPL");
