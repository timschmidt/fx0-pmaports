From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 00:18:17 -0500
Subject: [PATCH 14/22] media: venus: Declare MSM8226 firmware and report
 startup errors

Advertise the MDT and its loadable split files in module metadata.
Keep loader and PAS errors visible to callers, including probe deferral.
Convert positive secure service status to EIO for the driver core.

Signed-off-by: Timothy Schmidt <timschmidt@gmail.com>
---
 drivers/media/platform/qcom/venus/core.c     |  8 +++++++-
 drivers/media/platform/qcom/venus/firmware.c | 12 ++++++------
 2 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/drivers/media/platform/qcom/venus/core.c b/drivers/media/platform/qcom/venus/core.c
index 63893f37a..70a7a5aa7 100644
--- a/drivers/media/platform/qcom/venus/core.c
+++ b/drivers/media/platform/qcom/venus/core.c
@@ -798,6 +798,8 @@ static const struct bw_tbl msm8226_bw_dec[] = {
 	{  36000, 103000, 134000 },
 };
 
+#define MSM8226_VENUS_FIRMWARE "qcom/msm8226/venus"
+
 static const struct venus_resources msm8226_res = {
 	.freq_tbl = msm8226_freq_table,
 	.freq_tbl_size = ARRAY_SIZE(msm8226_freq_table),
@@ -813,7 +815,7 @@ static const struct venus_resources msm8226_res = {
 	.hfi_version = HFI_VERSION_1XX,
 	.vmem_id = VIDC_RESOURCE_NONE,
 	.dma_mask = DMA_BIT_MASK(31),
-	.fwname = "qcom/msm8226/venus.mdt",
+	.fwname = MSM8226_VENUS_FIRMWARE ".mdt",
 	.dec_nodename = "video-decoder",
 	.enc_nodename = "video-encoder",
 	.split_reg_banks = true,
@@ -1316,5 +1318,9 @@ static struct platform_driver qcom_venus_driver = {
 module_platform_driver(qcom_venus_driver);
 
 MODULE_ALIAS("platform:qcom-venus");
+MODULE_FIRMWARE(MSM8226_VENUS_FIRMWARE ".mdt");
+MODULE_FIRMWARE(MSM8226_VENUS_FIRMWARE ".b02");
+MODULE_FIRMWARE(MSM8226_VENUS_FIRMWARE ".b03");
+MODULE_FIRMWARE(MSM8226_VENUS_FIRMWARE ".b04");
 MODULE_DESCRIPTION("Qualcomm Venus video encoder and decoder driver");
 MODULE_LICENSE("GPL v2");
diff --git a/drivers/media/platform/qcom/venus/firmware.c b/drivers/media/platform/qcom/venus/firmware.c
index 5fc516310..c30bf0911 100644
--- a/drivers/media/platform/qcom/venus/firmware.c
+++ b/drivers/media/platform/qcom/venus/firmware.c
@@ -236,10 +236,9 @@ int venus_boot(struct venus_core *core)
 		fwpath = core->res->fwname;
 
 	ret = venus_load_fw(core, fwpath, &mem_phys, &mem_size);
-	if (ret) {
-		dev_err(dev, "fail to load video firmware\n");
-		return -EINVAL;
-	}
+	if (ret)
+		return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+				     "failed to load %s (status %d)\n", fwpath, ret);
 
 	core->fw.mem_size = mem_size;
 	core->fw.mem_phys = mem_phys;
@@ -250,7 +249,8 @@ int venus_boot(struct venus_core *core)
 		ret = venus_boot_no_tz(core, mem_phys, mem_size);
 
 	if (ret)
-		return ret;
+		return dev_err_probe(dev, ret < 0 ? ret : -EIO,
+				     "failed to start %s (status %d)\n", fwpath, ret);
 
 	if (core->use_tz && res->cp_size) {
 		/*
@@ -271,7 +271,7 @@ int venus_boot(struct venus_core *core)
 			qcom_scm_pas_shutdown(VENUS_PAS_ID);
 			dev_err(dev, "set virtual address ranges fail (%d)\n",
 				ret);
-			return ret;
+			return ret < 0 ? ret : -EIO;
 		}
 	}
 
