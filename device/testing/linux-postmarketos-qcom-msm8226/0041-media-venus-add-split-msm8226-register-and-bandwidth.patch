 drivers/media/platform/qcom/venus/core.c      | 102 ++++++++++++++++--
 drivers/media/platform/qcom/venus/core.h      |  17 +++
 drivers/media/platform/qcom/venus/firmware.c  |  40 +++----
 drivers/media/platform/qcom/venus/hfi_venus.c |  74 +++++++------
 .../media/platform/qcom/venus/pm_helpers.c    |  42 +++++---
 6 files changed, 276 insertions(+), 77 deletions(-)

