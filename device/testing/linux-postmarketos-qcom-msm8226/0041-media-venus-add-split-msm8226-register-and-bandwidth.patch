+static void __iomem *venus_fw_wrapper_addr(struct venus_core *core, u32 reg)
+{
+	if (IS_IRIS2(core) || IS_IRIS2_1(core))
+		return core->wrapper_tz_base + reg;
+	return venus_wrapper_addr(core, reg);
+}
