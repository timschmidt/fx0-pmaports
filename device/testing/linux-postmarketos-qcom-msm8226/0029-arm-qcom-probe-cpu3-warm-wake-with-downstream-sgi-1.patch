From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 21 Nov 2026 04:16:45 -0500
Subject: [PATCH 09/16] ARM: qcom: probe CPU3 warm wake with downstream SGI 1

(cherry picked from commit 85ae3cf7bc5016ccea2ef33cc78b3fe464dca081)
---
 arch/arm/mach-qcom/platsmp.c    |  4 ++++
 drivers/irqchip/irq-gic.c       | 21 ++++++++++++++++++---
 include/linux/irqchip/arm-gic.h |  1 +
 3 files changed, 23 insertions(+), 3 deletions(-)

diff --git a/arch/arm/mach-qcom/platsmp.c b/arch/arm/mach-qcom/platsmp.c
index 5c499f976..3c237bcbb 100644
--- a/arch/arm/mach-qcom/platsmp.c
+++ b/arch/arm/mach-qcom/platsmp.c
@@ -420,6 +420,10 @@ static int msm8226_boot_secondary(unsigned int cpu, struct task_struct *idle)
 #ifdef CONFIG_HOTPLUG_CPU
 	/* Publish the request before the bring-up path sends its boot SGI. */
 	smp_store_release(&per_cpu(msm8226_boot_requested, cpu), true);
+	/* The downstream firmware wake path uses hardware SGI 1. */
+	if (cpu == QCOM_MSM8226_HOTPLUG_PROBE_CPU &&
+	    per_cpu(cold_boot_done, cpu) && qcom_msm8226_hotplug_probe_active())
+		return gic_send_cpu_wakeup_sgi(cpu, 1);
 #endif
 	return cortex_a7_boot_secondary(cpu, idle);
 }
diff --git a/drivers/irqchip/irq-gic.c b/drivers/irqchip/irq-gic.c
index e0a61c4a5..ae8c07026 100644
--- a/drivers/irqchip/irq-gic.c
+++ b/drivers/irqchip/irq-gic.c
@@ -838,14 +838,14 @@ static int gic_set_affinity(struct irq_data *d, const struct cpumask *mask_val,
 	return IRQ_SET_MASK_OK_DONE;
 }
 
-static void gic_ipi_send_mask(struct irq_data *d, const struct cpumask *mask)
+static void gic_send_sgi_mask(unsigned int sgi, const struct cpumask *mask)
 {
 	int cpu;
 	unsigned long flags, map = 0;
 
 	if (unlikely(nr_cpu_ids == 1)) {
 		/* Only one CPU? let's do a self-IPI... */
-		writel_relaxed(2 << 24 | d->hwirq,
+		writel_relaxed(2 << 24 | sgi,
 			       gic_data_dist_base(&gic_data[0]) + GIC_DIST_SOFTINT);
 		return;
 	}
@@ -863,11 +863,26 @@ static void gic_ipi_send_mask(struct irq_data *d, const struct cpumask *mask)
 	dmb(ishst);
 
 	/* this always happens on GIC0 */
-	writel_relaxed(map << 16 | d->hwirq, gic_data_dist_base(&gic_data[0]) + GIC_DIST_SOFTINT);
+	writel_relaxed(map << 16 | sgi, gic_data_dist_base(&gic_data[0]) + GIC_DIST_SOFTINT);
 
 	gic_unlock_irqrestore(flags);
 }
 
+static void gic_ipi_send_mask(struct irq_data *d, const struct cpumask *mask)
+{
+	gic_send_sgi_mask(d->hwirq, mask);
+}
+
+int gic_send_cpu_wakeup_sgi(unsigned int cpu, unsigned int sgi)
+{
+	if (cpu >= nr_cpu_ids || cpu >= NR_GIC_CPU_IF || sgi > 7 ||
+	    !gic_data_dist_base(&gic_data[0]) || !READ_ONCE(gic_cpu_map[cpu]))
+		return -EINVAL;
+
+	gic_send_sgi_mask(sgi, cpumask_of(cpu));
+	return 0;
+}
+
 static int gic_starting_cpu(unsigned int cpu)
 {
 	gic_cpu_init(&gic_data[0]);
diff --git a/include/linux/irqchip/arm-gic.h b/include/linux/irqchip/arm-gic.h
index 7458c4c04..009184ac9 100644
--- a/include/linux/irqchip/arm-gic.h
+++ b/include/linux/irqchip/arm-gic.h
@@ -135,6 +135,7 @@ struct gic_chip_data;
 void gic_cascade_irq(unsigned int gic_nr, unsigned int irq);
 int gic_cpu_if_down(unsigned int gic_nr);
 int gic_cpu_quiesce_ppis(unsigned int gic_nr);
+int gic_send_cpu_wakeup_sgi(unsigned int cpu, unsigned int sgi);
 void gic_cpu_save(struct gic_chip_data *gic);
 void gic_cpu_restore(struct gic_chip_data *gic);
 void gic_dist_save(struct gic_chip_data *gic);
