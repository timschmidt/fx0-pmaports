From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 21 Nov 2026 04:16:45 -0500
Subject: [PATCH 08/16] ARM: qcom: probe MSM8226 hotplug warm entry on CPU3

(cherry picked from commit a37af0becb9c29e4b6da131fa7ded3fd5ca72ac7)
---
 arch/arm/mach-qcom/platsmp.c             |  6 ++
 drivers/cpuidle/cpuidle-qcom-spm.c       |  3 +-
 drivers/firmware/qcom/qcom_scm.c         | 29 ++++++---
 drivers/firmware/qcom/qcom_scm.h         |  1 +
 drivers/soc/qcom/Makefile                |  1 +
 drivers/soc/qcom/msm8226-hotplug-probe.h | 15 +++++
 drivers/soc/qcom/msm8226-pm.c            | 76 +++++++++++++++++++++++-
 drivers/soc/qcom/msm8226-warm-entry.S    | 39 ++++++++++++
 include/linux/firmware/qcom/qcom_scm.h   |  1 +
 include/soc/qcom/msm8226-pm.h            | 17 ++++++
 10 files changed, 176 insertions(+), 12 deletions(-)
 create mode 100644 drivers/soc/qcom/msm8226-hotplug-probe.h
 create mode 100644 drivers/soc/qcom/msm8226-warm-entry.S

diff --git a/arch/arm/mach-qcom/platsmp.c b/arch/arm/mach-qcom/platsmp.c
index 04729e1de..5c499f976 100644
--- a/arch/arm/mach-qcom/platsmp.c
+++ b/arch/arm/mach-qcom/platsmp.c
@@ -383,6 +383,9 @@ static DEFINE_PER_CPU(bool, msm8226_boot_requested);
 
 static int msm8226_cpu_disable(unsigned int cpu)
 {
+	if (qcom_msm8226_hotplug_probe_active() &&
+	    cpu != QCOM_MSM8226_HOTPLUG_PROBE_CPU)
+		return -EPERM;
 	if (qcom_msm8226_pm_active() && !cpu)
 		return -EPERM;
 	/* Publish a fresh offline interval before waiting for a new boot request. */
@@ -400,6 +403,9 @@ static void msm8226_cpu_die(unsigned int cpu)
 		return;
 	}
 	quiesced = !gic_cpu_quiesce_ppis(0);
+	if (cpu == QCOM_MSM8226_HOTPLUG_PROBE_CPU &&
+	    qcom_msm8226_hotplug_probe_active())
+		qcom_msm8226_hotplug_probe(quiesced);
 	/* Recheck after SGI cleanup so a concurrent boot request cannot be lost. */
 	while (!smp_load_acquire(&per_cpu(msm8226_boot_requested, cpu))) {
 		ret = quiesced ? qcom_msm8226_cpu_collapse(cpu) : -EIO;
diff --git a/drivers/cpuidle/cpuidle-qcom-spm.c b/drivers/cpuidle/cpuidle-qcom-spm.c
index 3dcc1f706..b5870684e 100644
--- a/drivers/cpuidle/cpuidle-qcom-spm.c
+++ b/drivers/cpuidle/cpuidle-qcom-spm.c
@@ -17,6 +17,7 @@
 #include <linux/cpuidle.h>
 #include <linux/cpu_pm.h>
 #include <linux/firmware/qcom/qcom_scm.h>
+#include <soc/qcom/msm8226-pm.h>
 #include <soc/qcom/spm.h>
 
 #include <asm/proc-fns.h>
@@ -156,7 +157,7 @@ static int spm_cpuidle_drv_probe(struct platform_device *pdev)
 			return PTR_ERR(spm);
 	}
 
-	ret = qcom_scm_set_warm_boot_addr(cpu_resume_arm);
+	ret = qcom_msm8226_set_warm_boot_addr(cpu_resume_arm);
 	if (ret)
 		return dev_err_probe(&pdev->dev, ret, "set warm boot addr failed");
 
diff --git a/drivers/firmware/qcom/qcom_scm.c b/drivers/firmware/qcom/qcom_scm.c
index 5f2d09046..53b465dba 100644
--- a/drivers/firmware/qcom/qcom_scm.c
+++ b/drivers/firmware/qcom/qcom_scm.c
@@ -455,6 +455,19 @@ int qcom_scm_set_cold_boot_addr(void *entry)
 }
 EXPORT_SYMBOL_GPL(qcom_scm_set_cold_boot_addr);
 
+static void qcom_scm_terminate_pc(u32 flags)
+{
+	struct qcom_scm_desc desc = {
+		.svc = QCOM_SCM_SVC_BOOT,
+		.cmd = QCOM_SCM_BOOT_TERMINATE_PC,
+		.args[0] = flags,
+		.arginfo = QCOM_SCM_ARGS(1),
+		.owner = ARM_SMCCC_OWNER_SIP,
+	};
+
+	qcom_scm_call_atomic(__scm ? __scm->dev : NULL, &desc, NULL);
+}
+
 /**
  * qcom_scm_cpu_power_down() - Power down the cpu
  * @flags:	Flags to flush cache
@@ -465,18 +478,16 @@ EXPORT_SYMBOL_GPL(qcom_scm_set_cold_boot_addr);
  */
 void qcom_scm_cpu_power_down(u32 flags)
 {
-	struct qcom_scm_desc desc = {
-		.svc = QCOM_SCM_SVC_BOOT,
-		.cmd = QCOM_SCM_BOOT_TERMINATE_PC,
-		.args[0] = flags & QCOM_SCM_FLUSH_FLAG_MASK,
-		.arginfo = QCOM_SCM_ARGS(1),
-		.owner = ARM_SMCCC_OWNER_SIP,
-	};
-
-	qcom_scm_call_atomic(__scm ? __scm->dev : NULL, &desc, NULL);
+	qcom_scm_terminate_pc(flags & QCOM_SCM_FLUSH_FLAG_MASK);
 }
 EXPORT_SYMBOL_GPL(qcom_scm_cpu_power_down);
 
+void qcom_scm_cpu_hotplug_power_down(void)
+{
+	qcom_scm_terminate_pc(QCOM_SCM_CORE_HOTPLUGGED);
+}
+EXPORT_SYMBOL_GPL(qcom_scm_cpu_hotplug_power_down);
+
 int qcom_scm_set_remote_state(u32 state, u32 id)
 {
 	struct qcom_scm_desc desc = {
diff --git a/drivers/firmware/qcom/qcom_scm.h b/drivers/firmware/qcom/qcom_scm.h
index caf03d659..3bfb8d250 100644
--- a/drivers/firmware/qcom/qcom_scm.h
+++ b/drivers/firmware/qcom/qcom_scm.h
@@ -93,6 +93,7 @@ int qcom_scm_shm_bridge_enable(struct device *scm_dev);
 #define QCOM_SCM_BOOT_SET_ADDR_MC	0x11
 #define QCOM_SCM_BOOT_SET_REMOTE_STATE	0x0a
 #define QCOM_SCM_FLUSH_FLAG_MASK	0x3
+#define QCOM_SCM_CORE_HOTPLUGGED	0x10
 #define QCOM_SCM_BOOT_MAX_CPUS		4
 #define QCOM_SCM_BOOT_MC_FLAG_AARCH64	BIT(0)
 #define QCOM_SCM_BOOT_MC_FLAG_COLDBOOT	BIT(1)
