+++ b/drivers/soc/qcom/Makefile
@@ -31,6 +31,7 @@ obj-$(CONFIG_QCOM_SMSM)	+= smsm.o
 obj-$(CONFIG_QCOM_SOCINFO)	+= socinfo.o
 obj-$(CONFIG_QCOM_SPM)		+= spm.o
 obj-$(CONFIG_QCOM_MSM8226_PM) += msm8226-pm.o
+obj-$(CONFIG_QCOM_MSM8226_PM) += msm8226-warm-entry.o
 obj-$(CONFIG_QCOM_STATS)	+= qcom_stats.o
 obj-$(CONFIG_QCOM_WCNSS_CTRL) += wcnss_ctrl.o
 obj-$(CONFIG_QCOM_APR) += apr.o
diff --git a/drivers/soc/qcom/msm8226-hotplug-probe.h b/drivers/soc/qcom/msm8226-hotplug-probe.h
new file mode 100644
index 000000000..13917bcfd
--- /dev/null
+++ b/drivers/soc/qcom/msm8226-hotplug-probe.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __MSM8226_HOTPLUG_PROBE_H__
+#define __MSM8226_HOTPLUG_PROBE_H__
+
+#define MSM8226_PROBE_ARMED		1
+#define MSM8226_PROBE_WARM_ENTRY	2
+#define MSM8226_PROBE_SCM_RETURNED	3
+#define MSM8226_PROBE_SPM_ERROR		4
+#define MSM8226_PROBE_GIC_ERROR		5
+
+#ifndef __ASSEMBLY__
+void msm8226_warm_probe_entry(void);
+#endif
+
+#endif
diff --git a/drivers/soc/qcom/msm8226-pm.c b/drivers/soc/qcom/msm8226-pm.c
index 308aa715b..5a84fd646 100644
--- a/drivers/soc/qcom/msm8226-pm.c
+++ b/drivers/soc/qcom/msm8226-pm.c
@@ -1,11 +1,13 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* MSM8226 system sleep: device preparation, transport handoff and CPU/L2 entry. */
+#include <linux/cache.h>
 #include <linux/cpu.h>
 #include <linux/cpu_pm.h>
 #include <linux/firmware/qcom/qcom_scm.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
@@ -24,6 +26,8 @@
 #include <asm/smp_plat.h>
 #include <asm/suspend.h>
 
+#include "msm8226-hotplug-probe.h"
+
 #define MSM8226_CPUS 4
 #define MSM8226_SLEEP_STATUS 0x8
 #define MSM8226_CPU_COLLAPSED BIT(19)
@@ -50,11 +54,78 @@ static struct msm8226_pm *msm8226_pm;
 /* SPM is built in, has no unregister path and suppresses manual unbinding. */
 static struct spm_driver_data *msm8226_cpu_spm[MSM8226_CPUS];
 
+static bool hotplug_probe;
+module_param(hotplug_probe, bool, 0400);
+MODULE_PARM_DESC(hotplug_probe, "Park CPU3 at the firmware warm vector until reboot");
+
+/* Firmware enters with the MMU off and writes the probe word directly. */
+u32 msm8226_warm_probe_state __cacheline_aligned;
+
+static int msm8226_get_probe_state(char *buf, const struct kernel_param *param)
+{
+	sync_cache_r(&msm8226_warm_probe_state);
+	return sprintf(buf, "%u\n", READ_ONCE(msm8226_warm_probe_state));
+}
+
+static const struct kernel_param_ops msm8226_probe_state_ops = {
+	.get = msm8226_get_probe_state,
+};
+module_param_cb(hotplug_probe_state, &msm8226_probe_state_ops, NULL, 0400);
+
+int qcom_msm8226_set_warm_boot_addr(void *resume)
+{
+	struct device_node *node;
+
+	/* Both the idle driver and the coordinator can register this vector. */
+	if (hotplug_probe) {
+		node = of_find_compatible_node(NULL, NULL, "qcom,msm8226-system-pm");
+		if (of_device_is_available(node))
+			resume = msm8226_warm_probe_entry;
+		of_node_put(node);
+	}
+
+	return qcom_scm_set_warm_boot_addr(resume);
+}
+
 bool qcom_msm8226_pm_active(void)
 {
 	return !!READ_ONCE(msm8226_pm);
 }
 
+bool qcom_msm8226_hotplug_probe_active(void)
+{
+	return hotplug_probe && qcom_msm8226_pm_active();
+}
+
+static void msm8226_publish_probe_state(u32 state)
+{
+	WRITE_ONCE(msm8226_warm_probe_state, state);
+	sync_cache_w(&msm8226_warm_probe_state);
+	dsb(sy);
+}
+
+void __noreturn qcom_msm8226_hotplug_probe(bool quiesced)
+{
+	struct spm_driver_data *spm =
+		READ_ONCE(msm8226_cpu_spm[QCOM_MSM8226_HOTPLUG_PROBE_CPU]);
+	u32 failure = MSM8226_PROBE_GIC_ERROR;
+
+	if (quiesced) {
+		failure = MSM8226_PROBE_SPM_ERROR;
+		if (!spm_msm8226_cpu_ready(spm) &&
+		    !spm_set_low_power_mode(spm, PM_SLEEP_MODE_SPC)) {
+			msm8226_publish_probe_state(MSM8226_PROBE_ARMED);
+			flush_cache_louis();
+			qcom_scm_cpu_hotplug_power_down();
+			spm_set_low_power_mode(spm, PM_SLEEP_MODE_STBY);
+			failure = MSM8226_PROBE_SCM_RETURNED;
+		}
+	}
+	msm8226_publish_probe_state(failure);
+	for (;;)
+		asm volatile("wfi" ::: "memory");
+}
+
 static int msm8226_core_finisher(unsigned long arg)
 {
 	qcom_scm_cpu_power_down(QCOM_SCM_CPU_PWR_DOWN_L2_ON);
@@ -403,7 +474,7 @@ static int msm8226_pm_probe(struct platform_device *pdev)
 	ret = qcom_cpr_msm8926_suspend_attach(&pm->cpr->dev, dev);
 	if (ret)
 		goto unregister_rpm;
-	ret = qcom_scm_set_warm_boot_addr(cpu_resume_arm);
+	ret = qcom_msm8226_set_warm_boot_addr(cpu_resume_arm);
 	if (ret)
 		goto detach_cpr;
 	cpus_write_lock();
@@ -417,7 +488,8 @@ static int msm8226_pm_probe(struct platform_device *pdev)
 	platform_set_drvdata(pdev, pm);
 	WRITE_ONCE(msm8226_pm, pm);
 	cpus_write_unlock();
-	schedule_work(&pm->install_work);
+	if (!hotplug_probe)
+		schedule_work(&pm->install_work);
 	return 0;
 
 detach_cpr:
diff --git a/drivers/soc/qcom/msm8226-warm-entry.S b/drivers/soc/qcom/msm8226-warm-entry.S
new file mode 100644
index 000000000..91f75385e
--- /dev/null
+++ b/drivers/soc/qcom/msm8226-warm-entry.S
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <soc/qcom/msm8226-pm.h>
+#include <asm/assembler.h>
+
+#include "msm8226-hotplug-probe.h"
+
+	.arm
+	.text
+ENTRY(msm8226_warm_probe_entry)
+	ARM_BE8(setend be)
+	mrc	p15, 0, r0, c0, c0, 5	@ MPIDR
+	ubfx	r1, r0, #0, #24
+	cmp	r1, #QCOM_MSM8226_HOTPLUG_PROBE_CPU	@ Cluster 0
+	bne	cpu_resume_arm
+
+	/* The MMU is off. Resolve the probe word relative to this entry. */
+	adr	r1, .Lprobe_offset
+	ldr	r2, [r1]
+	add	r1, r1, r2
+	ldr	r2, [r1]
+	cmp	r2, #0
+	beq	cpu_resume_arm
+
+	/*
+	 * CPU3 has no saved suspend context or valid late startup data.
+	 * Leave it parked after recording that firmware reached this vector.
+	 */
+	cpsid	aif
+	mov	r2, #MSM8226_PROBE_WARM_ENTRY
+	str	r2, [r1]
+	dsb	sy
+1:	wfi
+	b	1b
+ENDPROC(msm8226_warm_probe_entry)
+
+	.align	2
+.Lprobe_offset:
+	.word	msm8226_warm_probe_state - .Lprobe_offset
diff --git a/include/linux/firmware/qcom/qcom_scm.h b/include/linux/firmware/qcom/qcom_scm.h
index 2bf19b409..1b49a93f0 100644
--- a/include/linux/firmware/qcom/qcom_scm.h
+++ b/include/linux/firmware/qcom/qcom_scm.h
@@ -65,6 +65,7 @@ int qcom_scm_legacy_fuse_read(u32 address, u64 *value);
 int qcom_scm_set_cold_boot_addr(void *entry);
 int qcom_scm_set_warm_boot_addr(void *entry);
 void qcom_scm_cpu_power_down(u32 flags);
+void qcom_scm_cpu_hotplug_power_down(void);
 int qcom_scm_set_remote_state(u32 state, u32 id);
 
 struct qcom_scm_pas_metadata {
diff --git a/include/soc/qcom/msm8226-pm.h b/include/soc/qcom/msm8226-pm.h
index 264d5f250..e26c4921c 100644
--- a/include/soc/qcom/msm8226-pm.h
+++ b/include/soc/qcom/msm8226-pm.h
@@ -2,18 +2,35 @@
 #ifndef __SOC_QCOM_MSM8226_PM_H__
 #define __SOC_QCOM_MSM8226_PM_H__
 
+#define QCOM_MSM8226_HOTPLUG_PROBE_CPU	3
+
+#ifndef __ASSEMBLY__
 #include <linux/kconfig.h>
 #include <linux/types.h>
 #include <linux/errno.h>
+#include <linux/firmware/qcom/qcom_scm.h>
 
 #if IS_ENABLED(CONFIG_QCOM_MSM8226_PM)
 bool qcom_msm8226_pm_active(void);
 int qcom_msm8226_cpu_collapse(unsigned int cpu);
 int qcom_msm8226_cpu_kill(unsigned int cpu);
+int qcom_msm8226_set_warm_boot_addr(void *resume);
+bool qcom_msm8226_hotplug_probe_active(void);
+void __noreturn qcom_msm8226_hotplug_probe(bool quiesced);
 #else
 static inline bool qcom_msm8226_pm_active(void) { return false; }
 static inline int qcom_msm8226_cpu_collapse(unsigned int cpu) { return -ENODEV; }
 static inline int qcom_msm8226_cpu_kill(unsigned int cpu) { return 1; }
+static inline int qcom_msm8226_set_warm_boot_addr(void *resume)
+{
+	return qcom_scm_set_warm_boot_addr(resume);
+}
+static inline bool qcom_msm8226_hotplug_probe_active(void) { return false; }
+static inline void __noreturn qcom_msm8226_hotplug_probe(bool quiesced)
+{
+	unreachable();
+}
 #endif
 
+#endif /* __ASSEMBLY__ */
 #endif
