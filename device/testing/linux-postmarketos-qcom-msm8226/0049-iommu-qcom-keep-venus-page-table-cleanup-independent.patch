+static bool qcom_iommu_tlb_lock(struct qcom_iommu_dev *iommu, unsigned long *flags)
+{
+	if (!iommu->wrapper_clk_sel)
+		return true;
+
+	spin_lock_irqsave(&iommu->ctx_lock, *flags);
+	if (iommu->ctx_online)
+		return true;
