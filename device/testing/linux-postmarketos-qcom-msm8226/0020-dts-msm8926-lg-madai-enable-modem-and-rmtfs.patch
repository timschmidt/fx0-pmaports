From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Sat, 21 Nov 2026 00:26:39 -0500
Subject: [PATCH] ARM: dts: qcom: msm8926-lg-madai: enable the
 modem and its RMTFS region

Expose the stock RMTFS shared region (0x0fd80000, 0x180000, client 1)
by splitting the stock 4 MiB exclusion, and enable the MSM8926 MSS with
the stock-derived L3/L8/S5 supplies (S5 at 1.15 V).

Assisted-by: LLM [Claude Code]
---
 .../boot/dts/qcom/qcom-msm8926-lg-madai.dts   | 30 +++++++++++++++++--
 1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
index 17c1aaffb..6d538045c 100644
--- a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai.dts
@@ -158,12 +158,19 @@ cam_vio: regulator-camera-io {
 	};
 
 	reserved-memory {
-		/* Stock firmware excludes 5 MiB here; the first MiB is SMEM. */
+		/* Preserve the stock exclusion up to its RMTFS shared region. */
 		reserved@fb00000 {
-			reg = <0x0fb00000 0x400000>;
+			reg = <0x0fb00000 0x280000>;
 			no-map;
 		};
 
+		rmtfs@fd80000 {
+			compatible = "qcom,rmtfs-mem";
+			reg = <0x0fd80000 0x180000>;
+			no-map;
+			qcom,client-id = <1>;
+		};
+
 		smem_region: smem@fa00000 {
 			reg = <0x0fa00000 0x100000>;
 			no-map;
@@ -282,6 +289,18 @@ &mpss_region {
 	status = "okay";
 };
 
+&modem {
+	compatible = "qcom,msm8926-mss-pil";
+
+	/delete-property/ qcom,ext-bhs-reg;
+
+	mx-supply = <&pm8226_l3>;
+	pll-supply = <&pm8226_l8>;
+	mss-supply = <&pm8226_s5>;
+
+	status = "okay";
+};
+
 &pm8226_vadc {
 	channel@6 {
 		reg = <VADC_VBAT_SNS>;
@@ -325,6 +344,13 @@ &rpm_requests {
 	regulators {
 		compatible = "qcom,rpm-pm8226-regulators";
 
+		pm8226_s5: s5 {
+			regulator-min-microvolt = <1150000>;
+			regulator-max-microvolt = <1150000>;
+			regulator-allow-set-load;
+
+		};
+
 		pm8226_s4: s4 {
 			regulator-min-microvolt = <1800000>;
 			regulator-max-microvolt = <1800000>;
