From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 17 Nov 2026 23:11:47 -0500
Subject: [PATCH 02/22] dt-bindings: describe MSM8226 Venus and its IOMMU

---
 .../devicetree/bindings/iommu/qcom,iommu.yaml | 42 +++++++-
 .../bindings/media/qcom,msm8226-venus.yaml    | 98 +++++++++++++++++++
 2 files changed, 139 insertions(+), 1 deletion(-)
 create mode 100644 Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml

diff --git a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
index 126e12baf..14e37a875 100644
--- a/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
+++ b/Documentation/devicetree/bindings/iommu/qcom,iommu.yaml
@@ -39,6 +39,7 @@ properties:
           - qcom,msm8226-gpu-iommu
           - qcom,msm8226-vfe-iommu
           - qcom,msm8226-mdp-iommu
+          - qcom,msm8226-venus-iommu
           - qcom,msm8974-gpu-iommu
           - qcom,msm8974-mdp-iommu
           - qcom,msm8974-venus-iommu
@@ -61,7 +62,8 @@ properties:
     maxItems: 1
 
   reg:
-    maxItems: 1
+    minItems: 1
+    maxItems: 2
     description:
       For instances using the qcom,msm-iommu-v1/-v2 fallbacks, the
       optional "SMMU local" register region used for interrupt routing
@@ -69,6 +71,12 @@ properties:
       SMMU global register space, used for stream mapping configuration
       on non-secured instances and for the implementation-defined
       prefetch registers on all instances.
+      The MSM8226 Venus instance has a separate wrapper clock-select register.
+
+  reg-names:
+    items:
+      - const: global
+      - const: clock-select
 
   ranges: true
 
@@ -142,6 +150,38 @@ allOf:
       required:
         - reg
 
+  - if:
+      properties:
+        compatible:
+          const: qcom,msm8226-venus-iommu
+    then:
+      properties:
+        reg:
+          minItems: 2
+        clocks:
+          minItems: 3
+        clock-names:
+          minItems: 3
+        qcom,iommu-secure-id:
+          const: 0
+        iommu-ctx@0:
+          properties:
+            compatible:
+              const: qcom,msm-iommu-v1-ns
+      patternProperties:
+        "^iommu-ctx@(?!0$)[0-9a-f]+$": false
+      required:
+        - reg
+        - reg-names
+        - power-domains
+        - qcom,iommu-secure-id
+        - iommu-ctx@0
+    else:
+      properties:
+        reg:
+          maxItems: 1
+        reg-names: false
+
 additionalProperties: false
 
 examples:
diff --git a/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml b/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml
new file mode 100644
index 000000000..bb4b0fa8f
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/qcom,msm8226-venus.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8226 Venus video accelerator
+
+maintainers:
+  - Stanimir Varbanov <stanimir.k.varbanov@gmail.com>
+  - Vikash Garodia <quic_vgarodia@quicinc.com>
+
+description: |
+  The MSM8226 Venus IP provides video encoding and decoding. The codec
+  register ranges exclude the associated IOMMU and its wrapper clock
+  selector. The IOMMU supplies a non-secure context for video buffers.
+
+properties:
+  compatible:
+    const: qcom,msm8226-venus
+
+  reg:
+    items:
+      - description: Video bus interface (VBIF)
+      - description: CPU register block, including control status and interrupts
+      - description: Version register at wrapper offset 0
+      - description: Wrapper registers starting at offset 8
+
+  reg-names:
+    items:
+      - const: vbif
+      - const: cpu
+      - const: wrapper-version
+      - const: wrapper
+
+  interrupts:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Codec core clock
+      - description: Register interface clock
+      - description: Video AXI clock
+
+  clock-names:
+    items:
+      - const: core
+      - const: iface
+      - const: bus
+
+  power-domains:
+    maxItems: 1
+
+  iommus:
+    maxItems: 1
+
+  memory-region:
+    maxItems: 1
+    description: Reserved memory for the Venus firmware image
+
+  firmware-name:
+    maxItems: 1
+
+  interconnects:
+    items:
+      - description: Venus video data path to main memory
+      - description: CPU access path to the Venus configuration registers
+
+  interconnect-names:
+    items:
+      - const: video-mem
+      - const: cpu-cfg
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - clocks
+  - clock-names
+  - power-domains
+  - iommus
+  - memory-region
+
+allOf:
+  - if:
+      not:
+        properties:
+          status:
+            const: disabled
+        required:
+          - status
+    then:
+      required:
+        - interconnects
+        - interconnect-names
+
+additionalProperties: false
