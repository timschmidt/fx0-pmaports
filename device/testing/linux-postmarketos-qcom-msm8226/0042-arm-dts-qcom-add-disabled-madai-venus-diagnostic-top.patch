From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Tue, 17 Nov 2026 23:11:48 -0500
Subject: [PATCH 04/22] ARM: dts: qcom: add disabled Madai Venus diagnostic
 topology

Describe the verified stock firmware carveout, split register ownership, and nonsecure DMA aperture in an opt-in DTB. Keep the codec and IOMMU disabled while the interconnect providers and physical firmware startup are being qualified.
---
 arch/arm/boot/dts/qcom/Makefile               |  1 +
 .../dts/qcom/qcom-msm8926-lg-madai-venus.dts  | 62 +++++++++++++++++++
 2 files changed, 63 insertions(+)
 create mode 100644 arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai-venus.dts

diff --git a/arch/arm/boot/dts/qcom/Makefile b/arch/arm/boot/dts/qcom/Makefile
index d04ef20b2..d8b842956 100644
--- a/arch/arm/boot/dts/qcom/Makefile
+++ b/arch/arm/boot/dts/qcom/Makefile
@@ -38,6 +38,7 @@ dtb-$(CONFIG_ARCH_QCOM) += \
 	qcom-msm8916-samsung-serranove.dtb \
 	qcom-msm8926-htc-memul.dtb \
 	qcom-msm8926-lg-madai.dtb \
+	qcom-msm8926-lg-madai-venus.dtb \
 	qcom-msm8926-microsoft-superman-lte.dtb \
 	qcom-msm8926-microsoft-tesla.dtb \
 	qcom-msm8926-motorola-peregrine.dtb \
diff --git a/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai-venus.dts b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai-venus.dts
new file mode 100644
index 000000000..34f7ef2b0
--- /dev/null
+++ b/arch/arm/boot/dts/qcom/qcom-msm8926-lg-madai-venus.dts
@@ -0,0 +1,62 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "qcom-msm8926-lg-madai.dts"
+
+&{/reserved-memory} {
+	venus_mem: memory@f500000 {
+		reg = <0x0f500000 0x00500000>;
+		no-map;
+	};
+};
+
+&soc {
+	venus_iommu: iommu@fdc84000 {
+		compatible = "qcom,msm8226-venus-iommu";
+		reg = <0xfdc84000 0x2600>, <0xfdce0004 0x4>;
+		reg-names = "global", "clock-select";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		#iommu-cells = <1>;
+		ranges = <0 0xfdc8c000 0x1000>;
+
+		clocks = <&mmcc VENUS0_AHB_CLK>,
+			 <&mmcc VENUS0_AXI_CLK>,
+			 <&mmcc VENUS0_VCODEC0_CLK>;
+		clock-names = "iface", "bus", "tbu";
+		power-domains = <&mmcc VENUS0_GDSC>;
+		qcom,iommu-secure-id = <0>;
+		status = "disabled";
+
+		/* Content-protection and firmware contexts belong to secure world. */
+		iommu-ctx@0 {
+			compatible = "qcom,msm-iommu-v1-ns";
+			reg = <0 0x1000>;
+			interrupts = <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>;
+		};
+	};
+
+	venus-bus {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		dma-ranges = <0x40000000 0x40000000 0x40000000>;
+
+		video-codec@fdc80000 {
+			compatible = "qcom,msm8226-venus";
+			reg = <0xfdc80000 0x400>,
+			      <0xfdcc0000 0x20000>,
+			      <0xfdce0000 0x4>,
+			      <0xfdce0008 0x3ff8>;
+			reg-names = "vbif", "cpu", "wrapper-version", "wrapper";
+			interrupts = <GIC_SPI 44 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&mmcc VENUS0_VCODEC0_CLK>,
+				 <&mmcc VENUS0_AHB_CLK>,
+				 <&mmcc VENUS0_AXI_CLK>;
+			clock-names = "core", "iface", "bus";
+			power-domains = <&mmcc VENUS0_GDSC>;
+			iommus = <&venus_iommu 0>;
+			memory-region = <&venus_mem>;
+			status = "disabled";
+		};
+	};
+};
