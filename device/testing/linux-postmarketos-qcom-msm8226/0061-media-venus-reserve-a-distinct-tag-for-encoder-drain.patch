From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Wed, 18 Nov 2026 19:20:59 -0500
Subject: [PATCH 1/5] media: venus: Reserve a distinct tag for encoder drain

Firmware input completions carry the input tag. The synthetic encoder EOS marker previously shared tag zero with the first real VB2 buffer. Give EOS a reserved tag and keep its completion out of the VB2 queue.
---
 drivers/media/platform/qcom/venus/venc.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/drivers/media/platform/qcom/venus/venc.c b/drivers/media/platform/qcom/venus/venc.c
index 0f55bd019..271d68ac4 100644
--- a/drivers/media/platform/qcom/venus/venc.c
+++ b/drivers/media/platform/qcom/venus/venc.c
@@ -23,6 +23,7 @@
 #include "pm_helpers.h"
 
 #define NUM_B_FRAMES_MAX	4
+#define VENC_EOS_INPUT_TAG	U32_MAX
 
 /*
  * Three resons to keep MPLANE formats (despite that the number of planes
@@ -548,6 +549,8 @@ venc_encoder_cmd(struct file *file, void *fh, struct v4l2_encoder_cmd *cmd)
 		fdata.buffer_type = HFI_BUFFER_INPUT;
 		fdata.flags |= HFI_BUFFERFLAG_EOS;
 		fdata.device_addr = 0xdeadb000;
+		/* Input buffer completions otherwise identify VB2 buffer indices. */
+		fdata.clnt_data = VENC_EOS_INPUT_TAG;
 
 		ret = hfi_session_process_buf(inst, &fdata);
 
@@ -1358,6 +1361,9 @@ static void venc_buf_done(struct venus_inst *inst, unsigned int buf_type,
 
 	venc_pm_touch(inst);
 
+	if (buf_type == HFI_BUFFER_INPUT && tag == VENC_EOS_INPUT_TAG)
+		return;
+
 	if (buf_type == HFI_BUFFER_INPUT)
 		type = V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE;
 	else
