From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Timothy Schmidt <timschmidt@gmail.com>
Date: Tue, 17 Nov 2026 23:31:46 -0500
Subject: [PATCH 07/22] dt-bindings: Describe the MSM8226 Venus memory route

Describe the MMSS and BIMC endpoints. Allow the video memory path alone as used by the stock MSM8226 video driver.

Signed-off-by: Timothy Schmidt <timschmidt@gmail.com>
---
 .../bindings/interconnect/qcom,msm8226.yaml   | 58 +++++++++++++++++++
 .../bindings/media/qcom,msm8226-venus.yaml    |  2 +
 .../dt-bindings/interconnect/qcom,msm8226.h   | 13 +++++
 3 files changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/interconnect/qcom,msm8226.yaml
 create mode 100644 include/dt-bindings/interconnect/qcom,msm8226.h

diff --git a/Documentation/devicetree/bindings/interconnect/qcom,msm8226.yaml b/Documentation/devicetree/bindings/interconnect/qcom,msm8226.yaml
new file mode 100644
index 000000000..413b353d8
--- /dev/null
+++ b/Documentation/devicetree/bindings/interconnect/qcom,msm8226.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/qcom,msm8226.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm MSM8226 multimedia and memory interconnects
+
+maintainers:
+  - Georgi Djakov <djakov@kernel.org>
+
+description: |
+  The MMSS NoC connects the multimedia masters to the Bus Interconnect and
+  Memory Controller (BIMC). BIMC clock votes go to the RPM. The multimedia
+  fabric uses clocks from the multimedia clock controller.
+
+properties:
+  compatible:
+    enum:
+      - qcom,msm8226-bimc
+      - qcom,msm8226-mmssnoc
+
+  reg:
+    maxItems: 1
+
+  '#interconnect-cells':
+    const: 1
+
+  clocks:
+    items:
+      - description: Multimedia AXI root clock
+      - description: Multimedia NoC AXI branch
+
+  clock-names:
+    items:
+      - const: bus
+      - const: iface
+
+required:
+  - compatible
+  - reg
+  - '#interconnect-cells'
+
+allOf:
+  - if:
+      properties:
+        compatible:
+          const: qcom,msm8226-mmssnoc
+    then:
+      required:
+        - clocks
+        - clock-names
+    else:
+      properties:
+        clocks: false
+        clock-names: false
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml b/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml
index bb4b0fa8f..ab40e7200 100644
--- a/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml
+++ b/Documentation/devicetree/bindings/media/qcom,msm8226-venus.yaml
@@ -62,11 +62,13 @@ properties:
     maxItems: 1
 
   interconnects:
+    minItems: 1
     items:
       - description: Venus video data path to main memory
       - description: CPU access path to the Venus configuration registers
 
   interconnect-names:
+    minItems: 1
     items:
       - const: video-mem
       - const: cpu-cfg
diff --git a/include/dt-bindings/interconnect/qcom,msm8226.h b/include/dt-bindings/interconnect/qcom,msm8226.h
new file mode 100644
index 000000000..3378ede17
--- /dev/null
+++ b/include/dt-bindings/interconnect/qcom,msm8226.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+#ifndef __DT_BINDINGS_INTERCONNECT_QCOM_MSM8226_H
+#define __DT_BINDINGS_INTERCONNECT_QCOM_MSM8226_H
+
+/* MMSS NoC */
+#define MSM8226_MMSS_MASTER_VIDEO_P0	0
+#define MSM8226_MMSS_SLAVE_BIMC		1
+
+/* BIMC */
+#define MSM8226_BIMC_MASTER_MMSS		0
+#define MSM8226_BIMC_SLAVE_EBI_CH0	1
+
+#endif
